{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stats Perform STATS Editorial Reference Data API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Decode Network Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stats.com/v1/decode/networkTypes/",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "Your Stats Perform API key."
              }
            ]
          },
          "docs": "Returns the reference decode table for network type identifiers used in API responses. Path segments are case-sensitive."
        }
      ]
    }
  ],
  "bundled": true
}